# LLM Configuration
LLM_API_KEY=
# Optional, e.g. https://api.openai.com/v1. Leave empty for provider default.
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# News Search Configuration
# Required only for Tavily-powered news risk enrichment.
# If empty, news search returns no articles and news risk is neutral.
TAVILY_API_KEY=

# Langfuse Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_USER_ID=
LANGFUSE_FLUSH_ON_EXIT=true
